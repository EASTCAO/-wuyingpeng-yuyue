# 数据库连接字符串
# Zeabur 会自动注入此变量，本地开发时需要手动设置
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# 数据库连接是否启用 SSL。Zeabur 内网数据库保持 false；外部托管数据库通常设为 true
DATABASE_SSL=false

# 会话签名密钥，生产环境必须单独设置为随机长字符串，不要复用数据库连接串
AUTH_SECRET=replace-with-a-long-random-secret

# 首次创建用户时使用的初始密码
DEFAULT_USER_PASSWORD=123456

# 服务端口
PORT=3000

# 环境标识
NODE_ENV=development
