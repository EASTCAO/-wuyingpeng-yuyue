{
  "public": ".",
  "cleanUrls": false,
  "directoryListing": false,
  "headers": [
    {
      "source": "**/*.@(js|css|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "@(index.html|manifest.json|sw.js|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
